{
  "expo": {
    "name": "Сделка онлайн",
    "slug": "sdelka-online",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sdelka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ru.sdelka.online",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы сфотографировать паспорт и сделать селфи для проверки личности."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F6B5A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ru.sdelka.online"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F6B5A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Камера нужна, чтобы сфотографировать паспорт и сделать селфи для проверки личности.",
          "photosPermission": "Доступ к фото нужен, чтобы загрузить фото паспорта."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}