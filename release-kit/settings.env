# Настройки «Сделки онлайн». Строки с # не действуют. После изменения перезапустите приложение.
# Значения с пробелами или знаком # пишите в двойных кавычках, например ADMIN_PASSWORD="Qw#1 2345".

# Первый менеджер (администратор). Создаётся при первом запуске, потом пароль меняется в приложении.
# На сервере с доменом впишите свою почту и свой пароль: с demo1234 сервер не запустится.
ADMIN_EMAIL=manager@demo.ru
ADMIN_PASSWORD="demo1234"
ADMIN_NAME=Менеджер

# Демо-сделки для знакомства на своём компьютере. На сервере с адресом https они не создаются никогда.
# Чтобы начать с чистого листа, поставьте off и удалите папку data.
SEED=on

# Домен для установки на сервер через docker compose, например sdelka.ваша-компания.ru
# DOMAIN=

# Адрес, по которому клиенты открывают приложение (попадает в ссылки в SMS).
# APP_URL=https://sdelka.ваша-компания.ru

# Настоящие SMS через SMSC.ru вместо тестовых (нужен аккаунт и пополненный баланс):
# SMS_PROVIDER=smsc
# SMSC_LOGIN=
# SMSC_PASSWORD=""
# Имя отправителя, согласованное в SMSC.ru; без него SMS придут от общего имени.
# SMSC_SENDER=

# Оплата через Т-Кассу вместо тестовой (нужен договор с банком):
# PAYMENTS_PROVIDER=tkassa
# TKASSA_TERMINAL_KEY=
# TKASSA_PASSWORD=""
# PUBLIC_URL=https://sdelka.ваша-компания.ru

# Чеки по 54-ФЗ через онлайн-кассу Т-Банка. Значения уточните у бухгалтера.
# Система налогообложения: osn, usn_income, usn_income_outcome, esn, patent
# TKASSA_TAXATION=usn_income
# НДС: none (без НДС), vat0, vat5, vat7, vat10, vat20 и т. д.
# TKASSA_TAX=none
# Когда товар переходит клиенту: signing (при подписании, продажа в кредит) или full_payment (после полной оплаты)
# TKASSA_HANDOVER=signing

# Резервные копии базы: каждый день в папку backups рядом с базой, хранятся 14 последних.
# BACKUP_KEEP=14
