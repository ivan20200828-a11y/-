# Настройки «Сделки онлайн». Строки с # не действуют. После изменения перезапустите приложение.

# Первый менеджер (администратор). Создаётся при первом запуске, потом пароль меняется только в базе.
ADMIN_EMAIL=manager@demo.ru
ADMIN_PASSWORD=demo1234
ADMIN_NAME=Менеджер

# Демо-сделки для знакомства на своём компьютере. На сервере они не создаются.
# Чтобы начать с чистого листа, поставьте off и удалите папку data.
SEED=on

# Домен для установки на сервер через docker compose, например sdelka.ваша-компания.ru
# DOMAIN=

# Адрес, по которому клиенты открывают приложение (попадает в ссылки в SMS).
# APP_URL=https://sdelka.ваша-компания.ru

# Оплата через Т-Кассу вместо тестовой (нужен договор с банком):
# PAYMENTS_PROVIDER=tkassa
# TKASSA_TERMINAL_KEY=
# TKASSA_PASSWORD=
# PUBLIC_URL=https://sdelka.ваша-компания.ru
